# deploy.sh·docker-compose.yml이 읽는 부트스트랩 값. **비밀값이 아니다.**
# 비밀값(JWT_SECRET, DATABASE_URL, ...)은 SSM Parameter Store의 SSM_PARAMETER_PATH 아래에 있다.
# 이 파일을 deploy.env로 복사해 채운다.

AWS_REGION=ap-northeast-2
# ECR 리포지토리 URI (콘솔에서 복사). 태그는 붙이지 않는다.
ECR_REPO=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/nomos-server
# DuckDNS 도메인. 나중에 도메인을 사면 여기와 SSM의 API_BASE_URL만 바꾼다.
DOMAIN=your-team.duckdns.org
SSM_PARAMETER_PATH=/nomos/prod/
