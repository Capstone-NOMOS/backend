PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:55433/nomos_dev
JWT_SECRET=local-dev-secret-change-me-32chars-min
# base64로 디코딩해 정확히 32바이트여야 한다(아니면 GitHub 연동 완료 시점에 실패). 아래로 만들어 넣는다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
KMS_KEY_ID=
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LOG_LEVEL=info
NODE_ENV=development
COMMIT_INSPECTOR=mirror
# 프론트(Next) 로컬 주소. 초대 링크가 {이 값}/invites/{token}으로 만들어지고, 브라우저가 이 오리진에서 API를 부른다.
FRONTEND_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
